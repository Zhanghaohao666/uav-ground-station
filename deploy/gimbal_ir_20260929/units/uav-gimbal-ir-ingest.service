[Unit]
Description=Gimbal infrared RTSP to local RTP forwarding
After=network.target uav-main-network.service
PartOf=uav-video.target
RequiresMountsFor=/home/dev/uav_autostart /home/dev/rk3588_streamer /data/csj/rk3588_streamer
StartLimitIntervalSec=0

[Service]
Type=simple
User=dev
SupplementaryGroups=video render
WorkingDirectory=/home/dev/uav_autostart
ExecStart=/usr/bin/ffmpeg -nostdin -hide_banner -loglevel warning -rtsp_transport tcp -stimeout 5000000 -i rtsp://192.168.144.108:554/live/1 -map 0:v:0 -c:v copy -bsf:v dump_extra -an -f rtp rtp://127.0.0.1:5610
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=uav-video.target
