[Unit]
Description=Gimbal infrared RTSP endpoint on port 8556
After=network.target uav-main-network.service
PartOf=uav-video.target
RequiresMountsFor=/home/dev/uav_autostart /home/dev/rk3588_streamer /data/csj/rk3588_streamer
StartLimitIntervalSec=0

[Service]
Type=simple
User=dev
SupplementaryGroups=video render
WorkingDirectory=/home/dev/uav_autostart
ExecStart=/home/dev/uav_autostart/gimbal_ir_20260929/rtsp_relay_gimbal --port 8556 --mount /gimbal_ir 5610 h264
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=uav-video.target
